# Local experiment - not committed. Build with:
#   docker build -f Dockerfile.optimized -t face-auth:opt .

# ============================================================
# BUILDER
# ============================================================

FROM python:3.12-slim AS builder

ENV PIP_NO_CACHE_DIR=1 \
    PIP_DEFAULT_TIMEOUT=120 \
    PIP_RETRIES=10 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

COPY requirements.txt .

# 1. torch from the PyTorch CPU index. The PyPI wheel declares the whole
#    CUDA stack as dependencies (~2.5 GB of nvidia-* wheels) which is dead
#    weight on a CPU-only host.
# 2. requirements.txt then resolves against the already-satisfied torch,
#    so no CUDA wheels are pulled in.
# 3. insightface depends on non-headless opencv-python, which pip installs
#    over opencv-python-headless and needs X11 libs slim does not have.
#    Remove both and reinstall headless so it wins.
RUN pip install --no-cache-dir torch==2.14.0 \
        --index-url https://download.pytorch.org/whl/cpu \
 && pip install --no-cache-dir -r requirements.txt \
 && pip uninstall -y opencv-python opencv-python-headless \
 && pip install --no-cache-dir opencv-python-headless==4.10.0.84

# Inference-only pruning: C++ headers, bundled tests and static archives
# are only needed to compile extensions against torch.
RUN rm -rf /opt/venv/lib/python3.12/site-packages/torch/include \
           /opt/venv/lib/python3.12/site-packages/torch/test \
 && find /opt/venv -name "*.a" -delete \
 && find /opt/venv -name "__pycache__" -type d -prune -exec rm -rf {} + \
 && find /opt/venv -name "*.pyc" -delete

# Bake the InsightFace buffalo_l pack (~281 MB) into the image. Otherwise
# every cold start downloads it from GitHub Releases before serving traffic,
# which delays boot and makes the service fail when that host is unreachable.
ENV HOME=/home/app
RUN mkdir -p /home/app \
 && python -c "import insightface; insightface.app.FaceAnalysis(name='buffalo_l').prepare(ctx_id=-1, det_size=(640, 640))" \
 && find /home/app/.insightface -name "*.zip" -delete


# ============================================================
# RUNTIME
# ============================================================

FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    HOME=/home/app \
    PATH="/opt/venv/bin:$PATH"

RUN useradd --create-home --uid 10001 app

COPY --from=builder --chown=app:app /opt/venv /opt/venv
COPY --from=builder --chown=app:app /home/app/.insightface /home/app/.insightface

WORKDIR /app
COPY --chown=app:app . .

# render.yaml mounts a persistent disk here.
RUN mkdir -p /app/database && chown app:app /app/database

USER app

EXPOSE 8000

CMD ["sh", "-c", "uvicorn api.main:app --host 0.0.0.0 --port ${PORT:-8000}"]
